# 修真网络安全靶场 - 环境变量示例
# 复制此文件为 .env 并按需修改

# ============ 应用配置 ============
APP_NAME="修真网络安全靶场"
APP_ENV=development             # development | production
APP_DEBUG=true                  # true 仅在开发环境开启
APP_KEY=xxr-change-me-in-prod
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Shanghai

# ============ 数据库 ============
# 方式一（默认，Docker 部署）：MySQL
DB_CONNECTION=mysql
DB_HOST=db                       # Docker 部署用服务名，本地部署改为 localhost
DB_PORT=3306
DB_DATABASE=xiuxian_range
DB_USERNAME=xiuxian
DB_PASSWORD=xiuxian_pass

# 方式二（本机无 Docker/MySQL）：SQLite
# 1) php tools/init_sqlite_dev.php 初始化 storage/xxr_dev.db
# 2) php -S 127.0.0.1:8080 -t public server.php 启动（-t public 必不可少，否则静态资源 404）
# DB_CONNECTION=sqlite
# DB_DATABASE=H:/bachang/storage/xxr_dev.db

# ============ Redis ============
REDIS_HOST=redis
REDIS_PORT=6379

# ============ Session ============
SESSION_LIFETIME=7200            # Session 有效期（秒）

# ============ 关卡配置 ============
HINT_COST_H1=0                  # 弱提示免费
HINT_COST_H2=5                  # 中等提示 5 点
HINT_COST_H3=15                 # 完整答案 15 点
LEADERBOARD_SIZE=20             # 排行榜显示人数
REGISTER_ENABLED=true            # 是否开放注册