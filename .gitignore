# ============ 依赖 ============
/vendor/
/composer.lock

# ============ 环境配置 ============
/.env
/.env.local

# ============ 运行时存储 ============
/storage/logs/*.log
/storage/cache/*
/storage/sessions/*
/storage/uploads/*
!/storage/logs/.gitkeep
!/storage/cache/.gitkeep
!/storage/sessions/.gitkeep
!/storage/uploads/.gitkeep

# ============ 用户上传 ============
/public/uploads/*
!/public/uploads/.gitkeep

# ============ IDE / 编辑器 ============
.idea/
.vscode/
*.swp
*.swo
*~

# ============ 系统文件 ============
.DS_Store
Thumbs.db
desktop.ini

# ============ 测试覆盖率 ============
/tests/coverage/
.phpunit.result.cache

# ============ ZCode 会话状态 ============
/.zcode/plans/
# ============ 本地数据库（初始化脚本生成，不入库） ============
/storage/*.db
/tests/*.db
/xxr_test.db
/.github/

# ============ 关卡运行时产物（攻击演示写入的文件） ============
/public/challenges/**/stolen_cookies.txt
/public/challenges/**/uploads/*
/public/uploads/*
